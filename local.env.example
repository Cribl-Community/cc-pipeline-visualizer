# Copy to `local.env` for standalone development (`npm run dev`).
# Never commit `local.env` — it is git-ignored.

CRIBL_API_URL=https://main-<workspace>-<orgid>.cribl.cloud
CRIBL_CLIENT_ID=
CRIBL_CLIENT_SECRET=
CRIBL_TOKEN_URL=https://login.cribl.cloud/oauth/token
CRIBL_AUDIENCE=https://api.cribl.cloud

# Optional: set to `true` only for self-hosted Leaders with self-signed TLS.
# CRIBL_INSECURE_TLS=false
